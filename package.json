{
  "name": "vtex-sdk",
  "version": "0.3.0",
  "description": "Unofficial TypeScript SDK for the VTEX APIs (Node.js).",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fetch-schemas": "tsx scripts/fetch-schemas.ts",
    "codegen": "tsx scripts/codegen.ts",
    "live-check": "tsx scripts/live-check.ts",
    "check-doc-links": "tsx scripts/check-doc-links.ts",
    "check-doc-examples": "tsx scripts/check-doc-examples.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  },
  "license": "MIT",
  "author": "Heron Jr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heron-jr/vtex_sdk.git"
  },
  "homepage": "https://github.com/heron-jr/vtex_sdk#readme",
  "bugs": {
    "url": "https://github.com/heron-jr/vtex_sdk/issues"
  },
  "keywords": [
    "vtex",
    "sdk",
    "typescript",
    "openapi"
  ],
  "private": true
}
